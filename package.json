{
  "name": "vue3-category-path-finder",
  "version": "1.0.0",
  "description": "A Vue 3 Composition API application with TypeScript for finding category paths in nested structures",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && gh-pages -d dist",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.11.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.16",
    "c8": "^8.0.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  },
  "keywords": [
    "vue3",
    "typescript",
    "composition-api",
    "tailwindcss",
    "vitest",
    "category-finder",
    "nested-data"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vue3-category-path-finder.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/vue3-category-path-finder/issues"
  },
  "homepage": "https://github.com/yourusername/vue3-category-path-finder#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
